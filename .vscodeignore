# bundle 后产物自包含，源码与测试不进入 VSIX。
# 本文件与 scripts/release.mjs 的 VSIX 内容检查（必需清单 + 禁止模式 + 体积
# 阈值）互为防线：这里挡打包输入，发布脚本挡最终产物；新增运行时资产时两处
# 同步维护（约定见 AGENTS.md「打包与发布」）。
.vscode/**
.vscode-test/**
.vitest/**
.github/**
.agents/**
.scratch/**
scripts/**
node_modules/**
src/**
test/**
docs/**
esbuild.mjs
tsconfig.json
vitest.config.ts
CONTEXT.md
CLAUDE.md
AGENTS.md
README.en.md
out/test/**
# 本地浏览器截图与回归日志保存在 out/task*/，仅作测试留证。
out/task*/**
# 本地验证样图（如 mermaid 暗色修复的 before/after 探针）仅作留证，非运行时资产。
out/samples/**
# 本地工单草稿目录（#128 CSS 片段工单拆分留档）仅作过程留证，非运行时资产。
out/css-snippets-tickets/**
**/*.map
.gitignore
.git/**
package-lock.json
*.vsix
# 本地实施工件（依赖安装日志、验证日志目录）不进包（#132 实证 npm-install.log 曾混入）
npm-install.log
logs/**

# 原图仅存仓库溯源（1254×1254），VSIX 用 media/vsidian-icon-256.png
media/vsidian-icon.png

# 快速操作图标的 SVG/PNG 制作源仅存仓库；CSS 引用的 SVG 经 esbuild 进入 out/webview/assets。
media/quick-actions/**

# 样式参考独立 HTML 仅存仓库：无运行时加载方（设置页走 settings.js 内置数据模块，
# 契约检查器校验仓库副本）；同目录的 style-reference.json 是导出功能数据源，保留入包。
media/style-reference/style-reference.html
