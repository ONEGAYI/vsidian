{
  "name": "addon-t11",
  "publisher": "vsidian-test-fixture",
  "displayName": "Fixture Add-on (T11 UI Contribution)",
  "description": "Integration fixture: Vsidian add-on consuming the public ui SDK (toolbar buttons & panels) on the editor page (T11, #360).",
  "version": "0.0.1",
  "engines": { "vscode": "^1.82.3" },
  "extensionKind": ["workspace"],
  "extensionDependencies": ["onegayi.vsidian"],
  "keywords": ["vsidian-addon"],
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "vsidian-test-fixture.addon-t11.stats", "title": "Fixture T11: add-on stats" },
      { "command": "vsidian-test-fixture.addon-t11.queue", "title": "Fixture T11: queue a page command" },
      { "command": "vsidian-test-fixture.addon-t11.collect", "title": "Fixture T11: collect page results" },
      { "command": "vsidian-test-fixture.addon-t11.reset", "title": "Fixture T11: reset queues" }
    ]
  },
  "vsidianAddon": { "manifestVersion": 1, "api": "^1.0.0" },
  "main": "./extension.js"
}
